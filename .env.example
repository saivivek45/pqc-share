# Copy to backend/.env (or export as real environment variables).
# All values are optional for local development; sane defaults / auto-generation apply.

# 64+ random hex chars. Used to sign JWTs. Auto-generated into storage/.jwt_secret if unset.
PQSHARE_JWT_SECRET=

# 64 hex chars (32 bytes). Master key that wraps users' private keys at rest (AES-256-GCM).
# Auto-generated into storage/.master_key if unset. LOSING THIS KEY MAKES ALL STORED FILES UNRECOVERABLE.
PQSHARE_MASTER_KEY=

PQSHARE_DATABASE_URL=sqlite:///./storage/pqshare.db
PQSHARE_STORAGE_DIR=./storage
PQSHARE_MAX_UPLOAD_MB=100
PQSHARE_TOKEN_TTL_MINUTES=60
PQSHARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seed demo users alice/bob/carol on first start (development only!)
PQSHARE_SEED_DEMO=true
